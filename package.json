{
  "name": "bwg-core",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all -- --check",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "build": "cargo build --all-targets --all-features",
    "test": "bun run test:rust && bun run test:webcrypto",
    "test:rust": "cargo test --all-features",
    "test:webcrypto": "bun test conformance/bwg-0.1/crypto-vectors.test.mjs",
    "check:standards": "bun scripts/bright-builds-check.ts all",
    "verify": "bun run format:check && bun run lint && bun run build && bun run test && bun run check:standards"
  }
}
