{
  "openapi": "3.1.0",
  "info": {
    "title": "Bitcoin Work Gate Protocol",
    "version": "0.1.0"
  },
  "paths": {
    "/v0/challenges": {
      "post": {
        "summary": "Create a Work Challenge",
        "security": [{ "ServiceCredential": [], "ServiceClientId": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateChallengeRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable browser-safe challenge",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorkChallenge" } }
            }
          },
          "503": { "description": "Authority cannot sign approved Pool Offer terms" }
        }
      }
    },
    "/v0/trusted-consent": {
      "get": {
        "summary": "Load the Authority-owned Trusted Consent surface",
        "responses": {
          "200": {
            "description": "No-store trusted confirmation HTML",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v0/trusted-consent.js": {
      "get": {
        "summary": "Load the Authority-owned Trusted Consent browser module",
        "responses": {
          "200": {
            "description": "No-store browser module",
            "content": { "text/javascript": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v0/trusted-consent.css": {
      "get": {
        "summary": "Load the Authority-owned Trusted Consent styles",
        "responses": {
          "200": {
            "description": "No-store dark surface styles",
            "content": { "text/css": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v0/challenges/{challenge_id}/trusted-consent": {
      "get": {
        "summary": "Reload the Authority challenge and verification keys for trusted rendering",
        "parameters": [
          { "$ref": "#/components/parameters/ChallengeId" },
          {
            "name": "pool_offer_set_signature_sha256",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current immutable challenge and Authority JWKS",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustedConsentChallengeResponse" }
              }
            }
          },
          "404": { "description": "Unknown Work Challenge" }
        }
      },
      "post": {
        "summary": "Start or recover an Authority-owned Trusted Consent ceremony",
        "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TrustedConsentBeginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact persisted WebAuthn creation options",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustedConsentBeginResponse" }
              }
            }
          },
          "400": { "description": "Challenge does not require or match Trusted Consent" },
          "409": { "description": "Ceremony operation is already in progress" },
          "503": { "description": "Trusted authenticator verification is unavailable" }
        }
      }
    },
    "/v0/challenges/{challenge_id}/trusted-consent/{ceremony_id}": {
      "post": {
        "summary": "Finish Trusted Consent and recover its deterministic signed receipt",
        "parameters": [
          { "$ref": "#/components/parameters/ChallengeId" },
          {
            "name": "ceremony_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^ceremony_[A-Za-z0-9_]+$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebauthnRegistrationCredential" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Terminal verified ceremony and exact signed receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrustedConsentFinishResponse" }
              }
            }
          },
          "400": { "description": "Malformed, mismatched, or rejected WebAuthn response" },
          "409": { "description": "Ceremony operation is already in progress" },
          "410": { "description": "Ceremony or receipt lifetime has expired" },
          "503": { "description": "Trusted authenticator verification or receipt signing is unavailable" }
        }
      }
    },
    "/v0/challenges/{challenge_id}/events": {
      "get": {
        "summary": "Stream Verified Progress and Work Challenge lifecycle",
        "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }],
        "responses": {
          "200": {
            "description": "SSE verified_progress and challenge_lifecycle snapshots/updates; resync_required tells a lagged client to reconnect",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          }
        },
        "x-bwg-sse-events": {
          "verified_progress": { "$ref": "#/components/schemas/VerifiedProgressUpdate" },
          "challenge_lifecycle": { "$ref": "#/components/schemas/ChallengeLifecycle" },
          "resync_required": { "type": "string" }
        }
      }
    },
    "/v0/challenges/{challenge_id}/gate-pass": {
      "get": {
        "summary": "Look up durable Gate Pass issuance",
        "parameters": [
          { "$ref": "#/components/parameters/ChallengeId" },
          { "$ref": "#/components/parameters/ClaimantProof" }
        ],
        "responses": {
          "200": {
            "description": "Existing issuance state",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/IssuanceLookup" } }
            }
          },
          "401": { "$ref": "#/components/responses/InvalidClaimantProof" }
        }
      }
    },
    "/v0/challenges/{challenge_id}/lifecycle": {
      "get": {
        "summary": "Read the redacted durable Work Challenge lifecycle",
        "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }],
        "responses": {
          "200": {
            "description": "Current lifecycle and authorization eligibility",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChallengeLifecycle" } }
            }
          },
          "404": { "description": "Unknown Work Challenge" }
        }
      }
    },
    "/v0/challenges/{challenge_id}/pause": {
      "post": {
        "summary": "End active Work Leases while preserving challenge progress",
        "security": [{ "ServiceCredential": [], "ServiceClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PauseChallengeRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Paused lifecycle",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChallengeLifecycle" } }
            }
          },
          "403": { "description": "Credential does not control this Work Challenge" },
          "409": { "description": "Challenge is terminal or otherwise cannot be paused" }
        }
      }
    },
    "/v0/challenges/{challenge_id}/cancel": {
      "post": {
        "summary": "Terminally cancel a challenge after confirming progress loss",
        "security": [{ "ServiceCredential": [], "ServiceClientId": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ChallengeId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CancelChallengeRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Terminal cancelled lifecycle",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChallengeLifecycle" } }
            }
          },
          "400": { "description": "Destructive progress-loss confirmation is absent" },
          "403": { "description": "Credential does not control this Work Challenge" },
          "409": { "description": "Challenge can no longer be cancelled" }
        }
      }
    },
    "/account-creation/challenge": {
      "post": {
        "summary": "Create the reference Standard-policy challenge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BrowserChallengeRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Standard Work Challenge",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorkChallenge" } }
            }
          }
        }
      }
    },
    "/account-creation/redeem": {
      "post": {
        "summary": "Consume one Gate Pass and accept its Protected Action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RedemptionRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Durable Redemption Record and current outcome",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RedemptionRecord" } }
            }
          },
          "401": { "description": "Invalid, replayed, expired, or consumed authorization" }
        }
      }
    },
    "/account-creation/outcomes/{action_reference}": {
      "get": {
        "summary": "Look up an existing Protected Action outcome",
        "parameters": [
          { "$ref": "#/components/parameters/ActionReference" },
          { "$ref": "#/components/parameters/ClaimantProof" }
        ],
        "responses": {
          "200": {
            "description": "Existing Redemption Record and outcome",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RedemptionRecord" } }
            }
          },
          "401": { "$ref": "#/components/responses/InvalidClaimantProof" },
          "404": { "description": "Unknown, key-mismatched, or publicly expired outcome" }
        }
      }
    },
    "/.well-known/pow-gate-configuration": {
      "get": {
        "summary": "Discover Authority metadata without granting trust",
        "responses": { "200": { "description": "Authority Descriptor" } }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "summary": "Retrieve Authority verification keys",
        "responses": { "200": { "description": "JWKS document" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceCredential": {
        "type": "http",
        "scheme": "bearer"
      },
      "ServiceClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "bwg-client-id"
      }
    },
    "parameters": {
      "ChallengeId": {
        "name": "challenge_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^challenge_[A-Za-z0-9_-]+$" }
      },
      "ActionReference": {
        "name": "action_reference",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^action_[A-Za-z0-9_-]+$" }
      },
      "ClaimantProof": {
        "name": "bwg-claimant-proof",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "pattern": "^[^.]+\\.[^.]+\\.[^.]+$" }
      }
    },
    "responses": {
      "InvalidClaimantProof": {
        "description": "Missing, invalid, stale, wrong-key, or replayed Claimant proof"
      }
    },
    "schemas": {
      "CreateChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_policy", "action_reference", "claimant_key"],
        "properties": {
          "action_policy": { "type": "string" },
          "action_reference": { "type": "string" },
          "claimant_key": { "type": "string", "contentMediaType": "application/jwk+json" },
          "overrides": { "type": "object" }
        }
      },
      "BrowserChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimant_key"],
        "properties": {
          "claimant_key": { "type": "string", "contentMediaType": "application/jwk+json" }
        }
      },
      "PauseChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["user_requested", "tab_closed", "connectivity_lost"]
          }
        }
      },
      "CancelChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["confirm_progress_loss"],
        "properties": {
          "confirm_progress_loss": { "const": true }
        }
      },
      "ChallengeLifecycle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id", "state", "verified_progress", "work_requirement",
          "authorization_eligible", "expires_at_unix_seconds", "lifecycle_deadline_unix_seconds"
        ],
        "properties": {
          "challenge_id": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["issued", "active", "satisfied", "pass_issued", "cancelled", "expired"]
          },
          "verified_progress": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "work_requirement": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "authorization_eligible": { "type": "boolean" },
          "expires_at_unix_seconds": { "type": "integer", "minimum": 1 },
          "lifecycle_deadline_unix_seconds": { "type": "integer", "minimum": 1 }
        }
      },
      "VerifiedProgressUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id", "verified_progress", "work_requirement", "satisfied", "activity_estimate"
        ],
        "properties": {
          "challenge_id": { "type": "string" },
          "verified_progress": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "work_requirement": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "satisfied": { "type": "boolean" },
          "activity_estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": { "status": { "const": "unavailable" } }
          }
        }
      },
      "TrustedConsentBeginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pool_offer_set_signature_sha256", "reason", "authority_origin"],
        "properties": {
          "pool_offer_set_signature_sha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "reason": { "enum": ["elevated_work", "material_pool_terms"] },
          "authority_origin": { "type": "string", "format": "uri" }
        }
      },
      "TrustedConsentChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["challenge", "issuer", "jwks"],
        "properties": {
          "challenge": { "$ref": "#/components/schemas/WorkChallenge" },
          "issuer": { "type": "string", "format": "uri" },
          "jwks": { "type": "object" },
          "material_confirmation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["signed_pool_offers", "disclosure_digest_sha256"],
                "properties": {
                  "signed_pool_offers": { "$ref": "#/components/schemas/SignedPoolOfferSet" },
                  "disclosure_digest_sha256": {
                    "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"
                  }
                }
              }
            ]
          }
        }
      },
      "TrustedConsentBeginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ceremony_id", "authority_disclosure_digest_sha256", "public_key",
          "expires_at_unix_seconds"
        ],
        "properties": {
          "ceremony_id": { "type": "string", "pattern": "^ceremony_[A-Za-z0-9_]+$" },
          "authority_disclosure_digest_sha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "public_key": { "type": "object" },
          "expires_at_unix_seconds": { "type": "integer", "minimum": 1 }
        }
      },
      "WebauthnRegistrationCredential": {
        "type": "object",
        "required": ["id", "rawId", "response", "type"],
        "properties": {
          "id": { "type": "string" },
          "rawId": { "type": "string" },
          "type": { "const": "public-key" },
          "response": {
            "type": "object",
            "required": ["attestationObject", "clientDataJSON"],
            "properties": {
              "attestationObject": { "type": "string" },
              "clientDataJSON": { "type": "string" }
            }
          }
        }
      },
      "TrustedConsentFinishResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ceremony_id", "status", "trusted_consent_receipt"],
        "properties": {
          "ceremony_id": { "type": "string", "pattern": "^ceremony_[A-Za-z0-9_]+$" },
          "status": { "const": "verified" },
          "trusted_consent_receipt": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          }
        }
      },
      "WorkChallenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id", "action_policy", "action_reference", "claimant_key",
          "relying_service_audience", "allowed_origins", "work_requirement", "expires_at_unix_seconds",
          "pool_offers", "trusted_consent_disclosure_digest_sha256", "protocol_version"
        ],
        "properties": {
          "challenge_id": { "type": "string" },
          "action_policy": { "type": "string" },
          "action_reference": { "type": "string" },
          "claimant_key": { "type": "string" },
          "relying_service_audience": { "type": "string", "format": "uri" },
          "allowed_origins": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "work_requirement": { "type": "object" },
          "pool_offers": { "$ref": "#/components/schemas/SignedPoolOfferSet" },
          "trusted_consent_disclosure_digest_sha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "expires_at_unix_seconds": { "type": "integer", "minimum": 1 },
          "protocol_version": { "const": "BWG/0.1" }
        }
      },
      "SignedPoolOfferSet": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offers", "signature"],
        "properties": {
          "offers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PoolOffer" }
          },
          "signature": { "type": "string", "pattern": "^[^.]+\\.[^.]+\\.[^.]+$" }
        }
      },
      "PoolOffer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_id", "mining_pool", "pool_adapter", "mining_transport", "endpoint",
          "reward_policy", "payout_requirements", "privacy_terms_url", "operator_terms_url"
        ],
        "properties": {
          "offer_id": { "type": "string" },
          "mining_pool": { "$ref": "#/components/schemas/OfferComponentIdentity" },
          "pool_adapter": { "$ref": "#/components/schemas/OfferComponentIdentity" },
          "mining_transport": { "const": "stratum_v1" },
          "endpoint": { "type": "string", "pattern": "^stratum\\+tcp://" },
          "reward_policy": { "$ref": "#/components/schemas/RewardPolicy" },
          "payout_requirements": { "$ref": "#/components/schemas/PayoutRequirements" },
          "privacy_terms_url": { "type": "string", "format": "uri" },
          "operator_terms_url": { "type": "string", "format": "uri" }
        }
      },
      "OfferComponentIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "display_name", "version", "source_url", "license"],
        "properties": {
          "component_id": { "type": "string" },
          "display_name": { "type": "string" },
          "version": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "license": { "type": "string" }
        }
      },
      "RewardPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode", "selected_destination_basis_points", "pool_fee_basis_points",
          "service_fee_basis_points", "accepted_work_creates_revenue_claim",
          "creates_custodial_balance", "network_valid_result"
        ],
        "properties": {
          "mode": { "const": "solo_direct_coinbase" },
          "selected_destination_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "pool_fee_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "service_fee_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "accepted_work_creates_revenue_claim": { "const": false },
          "creates_custodial_balance": { "const": false },
          "network_valid_result": { "const": "direct_coinbase_payout" }
        }
      },
      "PayoutRequirements": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_required", "ephemeral_by_default", "accepted_destination_types",
          "approved_beneficiaries"
        ],
        "properties": {
          "selection_required": { "const": true },
          "ephemeral_by_default": { "const": true },
          "accepted_destination_types": {
            "type": "array",
            "items": { "enum": ["bitcoin_mainnet_address", "approved_beneficiary"] }
          },
          "approved_beneficiaries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ApprovedBeneficiary" }
          }
        }
      },
      "ApprovedBeneficiary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beneficiary_id", "display_name", "terms_url"],
        "properties": {
          "beneficiary_id": { "type": "string" },
          "display_name": { "type": "string" },
          "terms_url": { "type": "string", "format": "uri" }
        }
      },
      "GatePassClaims": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iss", "aud", "iat", "exp", "jti", "challenge_id", "protected_action_type",
          "action_reference", "action_policy", "cnf", "bwg_version"
        ],
        "properties": {
          "iss": { "type": "string", "format": "uri" },
          "aud": { "type": "string", "format": "uri" },
          "iat": { "type": "integer" },
          "exp": { "type": "integer" },
          "jti": { "type": "string" },
          "challenge_id": { "type": "string" },
          "protected_action_type": { "const": "account_creation" },
          "action_reference": { "type": "string" },
          "action_policy": { "type": "string" },
          "cnf": {
            "type": "object",
            "required": ["jkt"],
            "properties": { "jkt": { "type": "string" } }
          },
          "bwg_version": { "const": "BWG/0.1" }
        }
      },
      "ClaimantIssuanceProofClaims": {
        "allOf": [
          { "$ref": "#/components/schemas/RequestProofClaims" },
          {
            "type": "object",
            "required": ["challenge_id"],
            "properties": {
              "htm": { "const": "GET" },
              "challenge_id": { "type": "string" }
            }
          }
        ]
      },
      "DpopClaims": {
        "allOf": [
          { "$ref": "#/components/schemas/RequestProofClaims" },
          {
            "type": "object",
            "required": ["ath"],
            "properties": {
              "htm": { "const": "POST" },
              "ath": { "type": "string" }
            }
          }
        ]
      },
      "ClaimantOutcomeProofClaims": {
        "allOf": [
          { "$ref": "#/components/schemas/RequestProofClaims" },
          {
            "type": "object",
            "required": ["action_reference"],
            "properties": {
              "htm": { "const": "GET" },
              "action_reference": { "type": "string" }
            }
          }
        ]
      },
      "RequestProofClaims": {
        "type": "object",
        "required": ["jti", "htm", "htu", "iat"],
        "properties": {
          "jti": { "type": "string" },
          "htm": { "type": "string" },
          "htu": { "type": "string", "format": "uri" },
          "iat": { "type": "integer" },
          "challenge_id": { "type": "string" },
          "action_reference": { "type": "string" },
          "ath": { "type": "string" }
        }
      },
      "IssuanceLookup": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "pending" } } },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "gate_pass"],
            "properties": { "status": { "const": "issued" }, "gate_pass": { "type": "string" } }
          },
          { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "failed" } } }
        ]
      },
      "RedemptionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_pass", "dpop_proof", "action_reference"],
        "properties": {
          "gate_pass": { "type": "string" },
          "dpop_proof": { "type": "string" },
          "action_reference": { "type": "string" }
        }
      },
      "RedemptionRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["redemption_id", "action_reference", "accepted_at_unix_seconds", "outcome"],
        "properties": {
          "redemption_id": { "type": "string" },
          "action_reference": { "type": "string" },
          "accepted_at_unix_seconds": { "type": "integer" },
          "outcome": { "$ref": "#/components/schemas/ProtectedActionOutcome" }
        }
      },
      "ProtectedActionOutcome": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "pending" } } },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "result"],
            "properties": {
              "status": { "const": "succeeded" },
              "result": {
                "type": "object",
                "required": ["account_id"],
                "properties": { "account_id": { "type": "string" } }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": { "status": { "const": "failed" }, "reason": { "type": "string" } }
          }
        ]
      }
    }
  }
}
