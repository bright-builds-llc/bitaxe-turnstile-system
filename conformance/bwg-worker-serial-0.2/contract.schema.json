{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brightbuilds.dev/schemas/bwg-worker-serial-0.2-fixtures.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "manifest",
    "frames"
  ],
  "properties": {
    "profile": {
      "const": "bwg-worker-serial/0.2"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "frames": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frame",
          "wire"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "frame": {
            "$ref": "#/$defs/envelope"
          },
          "wire": {
            "type": "string",
            "maxLength": 66560
          }
        }
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "transport",
        "baudRate",
        "framing",
        "maximumControlPayloadBytes",
        "maximumWireFrameBytes",
        "heartbeatIntervalMilliseconds",
        "heartbeatTimeoutMilliseconds",
        "foregroundOnly",
        "hostToDeviceReceiveWindowBytes",
        "maximumHostWriteChunkBytes",
        "recordWriteTimeoutMilliseconds",
        "payloadIntegrity",
        "qualificationAttemptProfile",
        "poolDifficultyHintProfile"
      ],
      "properties": {
        "profile": {
          "const": "bwg-worker-serial/0.2"
        },
        "transport": {
          "const": "esp32s3_usb_serial_jtag"
        },
        "baudRate": {
          "const": 115200
        },
        "framing": {
          "const": "utf8_ndjson"
        },
        "maximumControlPayloadBytes": {
          "const": 65536
        },
        "maximumWireFrameBytes": {
          "const": 66560
        },
        "heartbeatIntervalMilliseconds": {
          "const": 1000
        },
        "heartbeatTimeoutMilliseconds": {
          "const": 2800
        },
        "foregroundOnly": {
          "const": true
        },
        "hostToDeviceReceiveWindowBytes": {
          "const": 2048
        },
        "maximumHostWriteChunkBytes": {
          "const": 1024
        },
        "recordWriteTimeoutMilliseconds": {
          "const": 2000
        },
        "payloadIntegrity": {
          "const": "sha256_exact_utf8_json"
        },
        "qualificationAttemptProfile": {
          "const": "worker-qualification-attempt-v1"
        },
        "poolDifficultyHintProfile": {
          "const": "worker-stratum-difficulty-hint-v1"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "kind",
        "sessionId",
        "sequence",
        "payload",
        "payloadBytes",
        "payloadSha256"
      ],
      "properties": {
        "profile": {
          "const": "bwg-worker-serial/0.2"
        },
        "kind": {
          "enum": [
            "session",
            "control",
            "heartbeat",
            "diagnostic"
          ]
        },
        "sessionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "payload": {
          "type": "object"
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 66560
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      }
    }
  }
}
