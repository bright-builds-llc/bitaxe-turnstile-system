{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brightbuilds.dev/schemas/bwg-worker-controller-0.3-fixtures.json",
  "title": "BWG Worker Controller 0.3 conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "semanticProfile",
    "transportProfile",
    "updateAuthorityKeys",
    "capabilities",
    "lease",
    "renewal",
    "status",
    "negativeTransfers",
    "usbVectors"
  ],
  "properties": {
    "profile": { "const": "bwg-worker-controller/0.3" },
    "semanticProfile": { "const": "bwg-worker-controller/0.1" },
    "transportProfile": { "const": "bwg-worker-usb/0.2" },
    "updateAuthorityKeys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/updateAuthorityKey" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "lease": { "$ref": "#/$defs/lease" },
    "renewal": { "$ref": "#/$defs/renewal" },
    "status": { "$ref": "#/$defs/status" },
    "negativeTransfers": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "expectedError"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "operation": { "enum": ["empty", "oversized", "invalid_utf8", "invalid_json", "missing_lf", "multiple_frames", "unknown_request_field"] },
          "expectedError": { "enum": ["invalid_frame", "invalid_message"] }
        }
      }
    },
    "usbVectors": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "request": { "$ref": "#/$defs/usbRequest" },
          "response": { "$ref": "#/$defs/usbResponse" },
          "requestText": { "type": "string" },
          "expectedError": { "enum": ["invalid_frame", "correlation"] }
        },
        "oneOf": [
          {
            "required": ["request", "response"],
            "properties": { "request": true, "response": true }
          },
          {
            "required": ["requestText", "expectedError"],
            "properties": { "requestText": true, "expectedError": true }
          }
        ]
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "usbRequestId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^usb_[A-Za-z0-9_-]+$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "board", "firmware", "compatibility", "transportProfile", "attestation"],
      "properties": {
        "protocolVersion": { "const": "bwg-worker-controller/0.3" },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "revision", "usbTransport"],
          "properties": {
            "model": { "$ref": "#/$defs/label" },
            "revision": { "$ref": "#/$defs/label" },
            "usbTransport": { "const": "web_usb" }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/$defs/label" },
            "version": { "$ref": "#/$defs/label" }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceFirmware", "workLease", "miningBaselineRestoration", "settingsPreservation"],
          "properties": {
            "referenceFirmware": { "type": "boolean" },
            "workLease": { "const": "supported" },
            "miningBaselineRestoration": { "const": "supported" },
            "settingsPreservation": { "enum": ["compatible", "upgrade_required", "unsupported"] }
          }
        },
        "transportProfile": { "const": "bwg-worker-usb/0.2" },
        "attestation": { "$ref": "#/$defs/capabilityAttestation" }
      }
    },
    "updateAuthorityKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "kid", "alg", "use", "key_ops"],
      "properties": {
        "kty": { "const": "OKP" },
        "crv": { "const": "Ed25519" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "kid": { "$ref": "#/$defs/label" },
        "alg": { "const": "Ed25519" },
        "use": { "const": "sig" },
        "key_ops": { "const": ["verify"] },
        "ext": { "type": "boolean" }
      }
    },
    "capabilityAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "compactJws"],
      "properties": {
        "claims": { "$ref": "#/$defs/capabilityClaims" },
        "compactJws": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
      }
    },
    "capabilityClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "protocolVersion", "board", "firmware", "compatibility", "transportProfile", "applicationDescriptorSha256"],
      "properties": {
        "profile": { "const": "bwg-reference-firmware-capability/0.1" },
        "protocolVersion": { "const": "bwg-worker-controller/0.3" },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "revision"],
          "properties": {
            "model": { "$ref": "#/$defs/label" },
            "revision": { "$ref": "#/$defs/label" }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/$defs/label" },
            "version": { "$ref": "#/$defs/label" }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceFirmware", "workLease", "miningBaselineRestoration", "settingsPreservation"],
          "properties": {
            "referenceFirmware": { "type": "boolean" },
            "workLease": { "const": "supported" },
            "miningBaselineRestoration": { "const": "supported" },
            "settingsPreservation": { "enum": ["compatible", "upgrade_required", "unsupported"] }
          }
        },
        "transportProfile": { "const": "bwg-worker-usb/0.2" },
        "applicationDescriptorSha256": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "leaseWindow": {
      "type": "object",
      "required": ["durationMilliseconds", "renewAfterMilliseconds"],
      "properties": {
        "durationMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "renewAfterMilliseconds": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "lease": {
      "allOf": [
        { "$ref": "#/$defs/leaseWindow" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "leaseId", "challengeId", "authorization", "durationMilliseconds", "renewAfterMilliseconds", "stratum"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "leaseId": { "$ref": "#/$defs/identifier" },
            "challengeId": { "$ref": "#/$defs/identifier" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 512 },
            "durationMilliseconds": true,
            "renewAfterMilliseconds": true,
            "stratum": {
              "type": "object",
              "additionalProperties": false,
              "required": ["endpoint", "username", "password"],
              "properties": {
                "endpoint": { "type": "string", "pattern": "^stratum\\+tcp://[^/@:?#]+:[1-9][0-9]{0,4}/$" },
                "username": { "type": "string", "minLength": 1, "maxLength": 512 },
                "password": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          }
        }
      ]
    },
    "renewal": {
      "allOf": [
        { "$ref": "#/$defs/leaseWindow" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "leaseId", "authorization", "durationMilliseconds", "renewAfterMilliseconds"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "leaseId": { "$ref": "#/$defs/identifier" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 512 },
            "durationMilliseconds": true,
            "renewAfterMilliseconds": true
          }
        }
      ]
    },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "state", "monotonicMilliseconds", "lease", "restoration"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "state": { "const": "mining" },
            "monotonicMilliseconds": { "type": "integer", "minimum": 0 },
            "lease": { "$ref": "#/$defs/statusLease" },
            "restoration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "pending" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "state", "monotonicMilliseconds", "restoration"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "state": { "const": "baseline" },
            "monotonicMilliseconds": { "type": "integer", "minimum": 0 },
            "restoration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "not_required" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "state", "monotonicMilliseconds", "restoration"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "state": { "const": "baseline" },
            "monotonicMilliseconds": { "type": "integer", "minimum": 0 },
            "restoration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "confirmed" },
                "reason": { "$ref": "#/$defs/restorationReason" }
              }
            }
          }
        }
      ]
    },
    "restorationReason": {
      "enum": ["paused", "cancelled", "lease_expired", "lost_continuity", "monotonic_reset", "reboot", "challenge_satisfied", "challenge_expired", "tab_closed", "connectivity_lost", "control_failed"]
    },
    "statusLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "challengeId", "renewAtMonotonicMilliseconds", "expiresAtMonotonicMilliseconds"],
      "properties": {
        "leaseId": { "$ref": "#/$defs/identifier" },
        "challengeId": { "$ref": "#/$defs/identifier" },
        "renewAtMonotonicMilliseconds": { "type": "integer", "minimum": 1 },
        "expiresAtMonotonicMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "usbRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "command"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "command": { "const": "discover" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "command", "payload"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "command": { "const": "start_lease" },
            "payload": { "$ref": "#/$defs/lease" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "command", "payload"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "command": { "const": "renew_lease" },
            "payload": { "$ref": "#/$defs/renewal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "command"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "command": { "enum": ["status", "pause", "cancel"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "command", "payload"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "command": { "const": "restore" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason"],
              "properties": { "reason": { "$ref": "#/$defs/restorationReason" } }
            }
          }
        }
      ]
    },
    "usbResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "ok", "result"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "ok": { "const": true },
            "result": {
              "oneOf": [
                { "$ref": "#/$defs/capabilities" },
                { "$ref": "#/$defs/status" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "ok", "error"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.3" },
            "requestId": { "$ref": "#/$defs/usbRequestId" },
            "ok": { "const": false },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "enum": ["invalid_request", "command_rejected"] },
                "message": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            }
          }
        }
      ]
    }
  }
}
