{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brightbuilds.dev/schemas/bwg-worker-possession-0.1-fixtures.json",
  "title": "BWG Worker Possession 0.1 conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "proofProfile", "fixtureIdentity", "initialAdmission", "reacquisition", "weakKeyForgery", "nonCanonicalWeakKeyForgery", "invalidSignWeakKeyForgery", "negativeCases"],
  "properties": {
    "profile": { "const": "bwg-worker-possession/0.1" },
    "proofProfile": { "const": "bwg-worker-possession-proof/0.1" },
    "fixtureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "publicJwk", "fingerprintSha256"],
      "properties": {
        "classification": { "const": "non_production_conformance_only" },
        "publicJwk": { "$ref": "#/$defs/publicJwk" },
        "fingerprintSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "initialAdmission": { "$ref": "#/$defs/exchange" },
    "reacquisition": { "$ref": "#/$defs/exchange" },
    "weakKeyForgery": { "$ref": "#/$defs/response" },
    "nonCanonicalWeakKeyForgery": { "$ref": "#/$defs/response" },
    "invalidSignWeakKeyForgery": { "$ref": "#/$defs/response" },
    "negativeCases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "expectedError"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "operation": {
            "enum": ["replay", "changed_nonce", "changed_purpose", "changed_challenge_binding", "changed_capability_digest", "changed_descriptor_digest", "changed_firmware_source_commit", "malformed_firmware_source_commit", "replacement_identity", "weak_identity_key", "unknown_request_field", "arbitrary_signing_request", "oversized_frame"]
          },
          "expectedError": { "enum": ["invalid_proof", "invalid_request", "invalid_frame"] }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "requestId": { "type": "string", "pattern": "^pos_[A-Za-z0-9_-]{1,124}$" },
    "purpose": { "enum": ["initial_admission", "transport_reacquisition"] },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "alg", "use", "key_ops"],
      "properties": {
        "kty": { "const": "OKP" },
        "crv": { "const": "Ed25519" },
        "x": { "$ref": "#/$defs/digest" },
        "alg": { "const": "Ed25519" },
        "use": { "const": "sig" },
        "key_ops": { "type": "array", "prefixItems": [{ "const": "verify" }], "items": false, "minItems": 1, "maxItems": 1 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "possessionNonce", "challengeBindingSha256", "controllerCapabilitySha256", "applicationDescriptorSha256"],
      "properties": {
        "purpose": { "$ref": "#/$defs/purpose" },
        "possessionNonce": { "$ref": "#/$defs/digest" },
        "challengeBindingSha256": { "$ref": "#/$defs/digest" },
        "controllerCapabilitySha256": { "$ref": "#/$defs/digest" },
        "applicationDescriptorSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "requestId", "command", "payload"],
      "properties": {
        "profile": { "const": "bwg-worker-possession/0.1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": { "const": "prove_possession" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "purpose", "possessionNonce", "challengeBindingSha256", "controllerCapabilitySha256", "applicationDescriptorSha256", "firmwareSourceCommit", "deviceIdentityJwk"],
      "properties": {
        "profile": { "const": "bwg-worker-possession-proof/0.1" },
        "purpose": { "$ref": "#/$defs/purpose" },
        "possessionNonce": { "$ref": "#/$defs/digest" },
        "challengeBindingSha256": { "$ref": "#/$defs/digest" },
        "controllerCapabilitySha256": { "$ref": "#/$defs/digest" },
        "applicationDescriptorSha256": { "$ref": "#/$defs/digest" },
        "firmwareSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "deviceIdentityJwk": { "$ref": "#/$defs/publicJwk" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "requestId", "ok", "result"],
      "properties": {
        "profile": { "const": "bwg-worker-possession/0.1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims", "compactJws"],
          "properties": {
            "claims": { "$ref": "#/$defs/claims" },
            "compactJws": { "type": "string", "minLength": 1, "maxLength": 8192 }
          }
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" }
      }
    }
  }
}
