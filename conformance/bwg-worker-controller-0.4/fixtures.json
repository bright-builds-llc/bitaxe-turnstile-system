      "base": "renewal",
      "overrides": {}
    },
    "wrong_lease_renewal": {
      "base": "renewal",
      "overrides": {
        "leaseId": "lease_other_01"
      }
    }
  },
  "scenarios": [
    {
      "id": "discover",
      "steps": [
        {
          "operation": "discover"
        }
      ],
      "expected": {
        "capabilities": true
      }
    },
    {
      "id": "start",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        }
      ],
      "expected": {
        "state": "mining"
      }
    },
    {
      "id": "renew",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "advance_monotonic",
          "value": 19999
        },
        {
          "operation": "renew",
          "input": "renewal"
        }
      ],
      "expected": {
        "state": "mining"
      }
    },
    {
