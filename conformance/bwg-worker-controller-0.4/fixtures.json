      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "advance_monotonic",
          "value": 20000
        },
        {
          "operation": "status"
        }
      ],
      "expected": {
        "state": "mining"
      }
    },
    {
      "id": "pause_restore",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "pause"
        }
      ],
      "expected": {
        "state": "baseline",
        "reason": "paused"
      }
    },
    {
      "id": "cancel_restore",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "cancel"
        }
      ],
      "expected": {
        "state": "baseline",
        "reason": "cancelled"
      }
    },
    {
