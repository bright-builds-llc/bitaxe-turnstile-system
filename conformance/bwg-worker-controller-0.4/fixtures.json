      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "advance_monotonic",
          "value": 60000
        }
      ],
      "expected": {
        "state": "baseline",
        "reason": "lease_expired"
      }
    },
    {
      "id": "lost_continuity_restore",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "lose_continuity",
          "value": "boot_fixture_lost"
        }
      ],
      "expected": {
        "state": "baseline",
        "reason": "lost_continuity"
      }
    },
    {
      "id": "monotonic_reset_restore",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "advance_monotonic",
          "value": 1000
        },
        {
          "operation": "reset_monotonic",
          "value": 5000
        }
      ],
      "expected": {
        "state": "baseline",
        "reason": "monotonic_reset"
      }
    },
    {
      "id": "reboot_restore",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "reboot",
          "value": "boot_fixture_rebooted"
        }
      ],
      "expected": {
        "state": "baseline",
        "reason": "reboot"
      }
    },
    {
      "id": "fresh_lease_after_reboot",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "reboot",
          "value": "boot_fixture_fresh"
        },
        {
          "operation": "start",
          "input": "fresh_lease"
        }
      ],
      "expected": {
        "state": "mining"
      }
    },
    {
      "id": "reject_oversized_lease",
      "steps": [
        {
          "operation": "start",
          "input": "oversized_lease"
        }
      ],
      "expected": {
        "error": "lease duration is outside the contract"
      }
    },
    {
      "id": "reject_invalid_authorization",
      "steps": [
        {
          "operation": "start",
          "input": "invalid_authorization"
        }
      ],
      "expected": {
        "error": "Work Lease authentication failed"
      }
    },
    {
      "id": "reject_stale_renewal",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "advance_monotonic",
          "value": 60000
        },
        {
          "operation": "renew",
          "input": "renewal"
        }
      ],
      "expected": {
        "error": "Work Lease is not active"
      }
    },
    {
      "id": "reject_wrong_lease_renewal",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "renew",
          "input": "wrong_lease_renewal"
        }
      ],
      "expected": {
        "error": "Work Lease authentication failed"
      }
    },
    {
      "id": "redacted_diagnostics",
      "steps": [
        {
          "operation": "start",
          "input": "lease"
        },
        {
          "operation": "status"
        }
      ],
      "expected": {
        "state": "mining",
        "redacted": true
