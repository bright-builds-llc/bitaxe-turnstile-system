{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brightbuilds.dev/schemas/bwg-worker-controller-0.1-fixtures.json",
  "title": "BWG Worker Controller 0.1 shared fixture contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "capabilities",
    "lease",
    "renewal",
    "inputs",
    "scenarios",
    "usbVectors"
  ],
  "properties": {
    "profile": { "const": "bwg-worker-controller/0.1" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "lease": { "$ref": "#/$defs/lease" },
    "renewal": { "$ref": "#/$defs/renewal" },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/inputDerivation" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "usbVectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/usbVector" }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "leaseWindow": {
      "type": "object",
      "$comment": "Runtime parsers additionally enforce renewAfterMilliseconds < durationMilliseconds.",
      "required": ["durationMilliseconds", "renewAfterMilliseconds"],
      "properties": {
        "durationMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "renewAfterMilliseconds": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "inputDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "overrides"],
      "properties": {
        "base": { "enum": ["lease", "renewal"] },
        "overrides": { "type": "object" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "steps", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation"],
            "properties": {
              "operation": {
                "enum": [
                  "discover",
                  "start",
                  "renew",
                  "status",
                  "pause",
                  "cancel",
                  "advance_monotonic",
                  "lose_continuity",
                  "reset_monotonic",
                  "reboot"
                ]
              },
              "input": { "type": "string" },
              "value": {
                "oneOf": [{ "type": "integer" }, { "type": "string" }]
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilities": { "type": "boolean" },
            "state": { "enum": ["baseline", "mining"] },
            "reason": { "type": "string" },
            "error": { "type": "string" },
            "redacted": { "type": "boolean" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "board", "firmware", "compatibility"],
      "properties": {
        "protocolVersion": { "const": "bwg-worker-controller/0.1" },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "revision", "usbTransport"],
          "properties": {
            "model": { "$ref": "#/$defs/boundedString" },
            "revision": { "$ref": "#/$defs/boundedString" },
            "usbTransport": { "const": "web_serial" }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/$defs/boundedString" },
            "version": { "$ref": "#/$defs/boundedString" }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceFirmware",
            "workLease",
            "miningBaselineRestoration",
            "settingsPreservation"
          ],
          "properties": {
            "referenceFirmware": { "type": "boolean" },
            "workLease": { "const": "supported" },
            "miningBaselineRestoration": { "const": "supported" },
            "settingsPreservation": {
              "enum": ["compatible", "upgrade_required", "unsupported"]
            }
          }
        }
      }
    },
    "lease": {
      "allOf": [
        { "$ref": "#/$defs/leaseWindow" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersion",
            "leaseId",
            "challengeId",
            "authorization",
            "durationMilliseconds",
            "renewAfterMilliseconds",
            "stratum"
          ],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.1" },
            "leaseId": { "$ref": "#/$defs/identifier" },
            "challengeId": { "$ref": "#/$defs/identifier" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 512 },
            "durationMilliseconds": true,
            "renewAfterMilliseconds": true,
            "stratum": {
              "type": "object",
              "additionalProperties": false,
              "required": ["endpoint", "username", "password"],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "pattern": "^stratum\\+tcp://[^/@:?#]+:[1-9][0-9]{0,4}/$"
                },
                "username": { "type": "string", "minLength": 1, "maxLength": 512 },
                "password": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          }
        }
      ]
    },
    "renewal": {
      "allOf": [
        { "$ref": "#/$defs/leaseWindow" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersion",
            "leaseId",
            "authorization",
            "durationMilliseconds",
            "renewAfterMilliseconds"
          ],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.1" },
            "leaseId": { "$ref": "#/$defs/identifier" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 512 },
            "durationMilliseconds": true,
            "renewAfterMilliseconds": true
          }
        }
      ]
    },
    "usbVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "response"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "request": {
          "type": "object",
          "required": ["protocolVersion", "requestId", "command"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.1" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "command": { "type": "string" },
            "payload": true
          }
        },
        "response": {
          "type": "object",
          "required": ["protocolVersion", "requestId", "ok"],
          "properties": {
            "protocolVersion": { "const": "bwg-worker-controller/0.1" },
            "requestId": { "$ref": "#/$defs/identifier" },
            "ok": { "type": "boolean" },
            "result": true,
            "error": true
          }
        }
      }
    }
  }
}
