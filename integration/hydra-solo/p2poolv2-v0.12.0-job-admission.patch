+#[tokio::test]
+async fn prototype_exact_candidate_and_outputs_are_admitted_before_job_release() {
+    // Arrange
+    let template = Arc::new(test_template());
+    let expected_output = bitcoin::TxOut {
+        value: bitcoin::Amount::from_sat(template.coinbasevalue),
+        script_pubkey: test_address().script_pubkey(),
+    };
+    let prepared = test_notify_params_builder(Arc::clone(&template), false)
+        .build()
+        .expect("prepared builder should succeed");
+    let tracker = start_tracker_actor();
+    let variant =
+        build_unadmitted_job_variant(&prepared, Some(&test_address()), &tracker, "01020304")
+            .expect("exact job variant should be constructible");
+    let job_id = variant.job_id;
+    let candidate_hash = variant.canonical_block().block_hash();
+    assert_eq!(variant.coinbase_outputs()[0], expected_output);
+    assert!(variant.coinbase_outputs().len() >= 2);
+    assert!(variant.canonical_block().check_merkle_root());
+    assert!(variant.canonical_block().check_witness_commitment());
+    crate::stratum::work::job_admission::validate_candidate(
+        &variant,
+        &expected_output.script_pubkey,
+    )
+    .expect("the exact candidate should match its template and Reward Policy");
+    assert!(tracker.get_job(job_id).is_none());
+
+    // Act
+    let (admit_tx, admit_rx) = tokio::sync::oneshot::channel::<()>();
+    let tracker_for_task = Arc::clone(&tracker);
+    let admission = tokio::spawn(async move {
+        admit_rx.await.expect("prototype admission should resolve");
+        assert_eq!(variant.canonical_block().block_hash(), candidate_hash);
+        assert_eq!(variant.coinbase_outputs()[0], expected_output);
+        publish_admitted_job_variant(variant, &tracker_for_task)
+    });
+
+    tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    assert!(tracker.get_job(job_id).is_none());
+    admit_tx.send(()).expect("admission receiver should exist");
+    let notify_json = admission.await.expect("admission task should finish");
+
+    // Assert
+    assert!(tracker.get_job(job_id).is_some());
+    assert!(notify_json.contains("mining.notify"));
+}
