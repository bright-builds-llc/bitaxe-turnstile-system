+#[tokio::test]
+async fn admission_rejects_a_reward_policy_payout_mismatch() {
+    // Arrange
+    let tracker = start_tracker_actor();
+    let variant = test_variant(&tracker);
+    let wrong_script = Address::p2wpkh(
+        &"0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"
+            .parse::<CompressedPublicKey>()
+            .expect("test key should parse"),
+        Network::Signet,
+    )
+    .script_pubkey();
+
+    // Act
+    let result = crate::stratum::work::job_admission::validate_candidate(&variant, &wrong_script);
+
+    // Assert
+    assert_eq!(
+        result,
+        Err(crate::stratum::work::job_admission::AdmissionError::RewardPolicyMismatch)
+    );
+    assert!(tracker.get_job(variant.job_id()).is_none());
