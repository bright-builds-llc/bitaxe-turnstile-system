+#[tokio::test]
+async fn blocked_partial_release_times_out_rolls_back_and_unblocks_templates() {
+    // Arrange
+    let admitted = Arc::new(
+        test_notify_params_builder(Arc::new(test_template()), false)
+            .build()
+            .expect("admitted builder should succeed"),
+    );
+    let replacement = Arc::new(
+        test_notify_params_builder(Arc::new(test_template()), false)
+            .build()
+            .expect("replacement builder should succeed"),
+    );
+    let (template_tx, template_rx) = tokio::sync::watch::channel(Some(Arc::clone(&admitted)));
+    let tracker = start_tracker_actor();
+    let variant =
+        build_unadmitted_job_variant(&admitted, Some(&test_address()), &tracker, "01020304")
+            .expect("variant should build");
+    let job_id = variant.job_id();
+    let generation_gate = Arc::new(tokio::sync::Mutex::new(()));
+    let (mut blocked_writer, _unread_peer) = tokio::io::duplex(1);
+    let started = std::time::Instant::now();
+
+    // Act
+    let result = crate::stratum::server::publish_if_current(
+        &admitted,
+        &template_rx,
+        variant,
+        &tracker,
+        &generation_gate,
+        &mut blocked_writer,
+    )
+    .await;
+    let elapsed = started.elapsed();
+    let update_result = {
+        let _guard = generation_gate.lock().await;
+        template_tx.send(Some(Arc::clone(&replacement)))
+    };
+
+    // Assert
+    assert_eq!(result, Err(AdmissionError::ReleaseFailed));
+    assert!(elapsed < std::time::Duration::from_secs(1));
+    assert!(tracker.get_job(job_id).is_none());
+    assert!(update_result.is_ok());
+    assert!(
+        template_rx
+            .borrow()
+            .as_ref()
+            .is_some_and(|current| Arc::ptr_eq(current, &replacement))
+    );
+}
