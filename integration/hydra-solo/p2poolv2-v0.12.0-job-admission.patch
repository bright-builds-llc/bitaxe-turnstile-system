+#[tokio::test]
+async fn proposal_concurrency_is_bounded_before_bitcoin_core() {
+    // Arrange
+    let tracker = start_tracker_actor();
+    let first = test_variant(&tracker);
+    let second = test_variant(&tracker);
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .set_delay(std::time::Duration::from_millis(100))
+                .set_body_json(serde_json::json!({
+                    "result": null,
+                    "error": null,
+                    "id": 0
+                })),
+        )
+        .mount(&server)
+        .await;
+    let admission = BitcoinCoreJobAdmission::new(
+        BitcoindRpcClient::new(&server.uri(), "testuser", "testpass")
+            .expect("mock RPC client should build"),
+        test_address().script_pubkey(),
+        std::time::Duration::from_secs(1),
+        1,
+    )
+    .expect("admission config should be valid");
+    // Act
+    let first_admission = admission.clone();
+    let first_task = tokio::spawn(async move { first_admission.admit(&first).await });
+    tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+    assert_eq!(admission.available_proposal_slots(), 0);
+    let second_admission = admission.clone();
+    let second_task = tokio::spawn(async move { second_admission.admit(&second).await });
+    tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+
+    let requests_while_first_is_active = server
+        .received_requests()
+        .await
+        .expect("mock server should retain requests")
+        .len();
+    let (first_result, second_result) = tokio::join!(first_task, second_task);
+
+    // Assert
+    assert_eq!(requests_while_first_is_active, 1);
+    assert!(first_result.expect("first task should join").is_ok());
+    assert!(second_result.expect("second task should join").is_ok());
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .expect("mock server should retain requests")
+            .len(),
+        2
+    );
+}
