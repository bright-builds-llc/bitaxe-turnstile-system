+#[tokio::test]
+async fn generation_gate_serializes_template_update_with_tracker_and_socket_release() {
+    use tokio::io::AsyncReadExt as _;
+
+    // Arrange
+    let prepared = Arc::new(
+        test_notify_params_builder(Arc::new(test_template()), false)
+            .build()
+            .expect("prepared builder should succeed"),
+    );
+    let replacement = Arc::new(
+        test_notify_params_builder(Arc::new(test_template()), false)
+            .build()
+            .expect("replacement builder should succeed"),
+    );
+    let (template_tx, template_rx) = tokio::sync::watch::channel(Some(Arc::clone(&prepared)));
+    let generation_gate = Arc::new(tokio::sync::Mutex::new(()));
+    let tracker = start_tracker_actor();
+    let variant =
+        build_unadmitted_job_variant(&prepared, Some(&test_address()), &tracker, "01020304")
+            .expect("variant should build");
+    let job_id = variant.job_id();
+    let (mut writer, mut reader) = tokio::io::duplex(1);
+    let admitted_for_task = Arc::clone(&prepared);
+    let tracker_for_task = Arc::clone(&tracker);
+    let gate_for_publish = Arc::clone(&generation_gate);
+    let current_template_rx = template_rx.clone();
+
+    // Act
+    let publish_task = tokio::spawn(async move {
+        crate::stratum::server::publish_if_current(
+            &admitted_for_task,
+            &template_rx,
+            variant,
+            &tracker_for_task,
+            &gate_for_publish,
+            &mut writer,
+        )
+        .await
+    });
+    tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+    assert!(generation_gate.try_lock().is_err());
+    let gate_for_update = Arc::clone(&generation_gate);
+    let update_task = tokio::spawn(async move {
+        let _guard = gate_for_update.lock().await;
+        template_tx
+            .send(Some(Arc::clone(&replacement)))
+            .expect("template receiver should remain open");
+        replacement
+    });
+    tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+    {
+        let current_before_release = current_template_rx.borrow();
+        assert!(
+            current_before_release
+                .as_ref()
+                .is_some_and(|current| Arc::ptr_eq(current, &prepared))
+        );
+    }
+    let mut released_bytes = Vec::new();
+    reader
+        .read_to_end(&mut released_bytes)
+        .await
+        .expect("released notify should be readable");
+    let publish_result = publish_task.await.expect("publish task should join");
+    let replacement = update_task.await.expect("update task should join");
+
+    // Assert
+    assert_eq!(publish_result, Ok(()));
+    assert!(tracker.get_job(job_id).is_some());
+    assert!(
+        String::from_utf8(released_bytes)
+            .expect("notify should be UTF-8")
+            .contains("mining.notify")
+    );
+    let current = current_template_rx.borrow();
+    assert!(
+        current
+            .as_ref()
+            .is_some_and(|current| Arc::ptr_eq(current, &replacement))
+    );
+    assert!(!Arc::ptr_eq(&prepared, &replacement));
+}
