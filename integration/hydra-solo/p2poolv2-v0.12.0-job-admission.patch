@@ -0,0 +1,286 @@
+// Copyright (C) 2024-2026 P2Poolv2 Developers (see AUTHORS)
+//
+// This file is part of P2Poolv2.
+
+use std::{sync::Arc, time::Duration};
+
+use bitcoin::{ScriptBuf, Target, consensus::encode::serialize};
+use bitcoindrpc::BitcoindRpcClient;
+use serde_json::{Map, Value, json};
+use sha2::{Digest as _, Sha256};
+use thiserror::Error;
+use tokio::{sync::Semaphore, time::Instant};
+
+use super::prepared_notify::UnadmittedJobVariant;
+
+const WORKER_MUTATION_PROFILE: &str = "extranonce2,header_time,negotiated_version_bits,nonce";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct AdmissionReceipt {
+    candidate_digest: String,
+    latency_milliseconds: u128,
+}
+
+impl AdmissionReceipt {
+    pub(crate) fn candidate_digest(&self) -> &str {
+        &self.candidate_digest
+    }
+
+    pub(crate) fn latency_milliseconds(&self) -> u128 {
+        self.latency_milliseconds
+    }
+}
+
+#[derive(Debug, Error, Clone, PartialEq, Eq)]
+pub(crate) enum AdmissionError {
+    #[error("job candidate is missing or contains invalid template data")]
+    MissingTemplateData,
+    #[error("job candidate previous block does not match its template")]
+    PreviousBlockMismatch,
+    #[error("job candidate target does not match its template")]
+    TargetMismatch,
+    #[error("job candidate transaction set does not match its template")]
+    TransactionMismatch,
+    #[error("job candidate commitment validation failed")]
+    CommitmentMismatch,
+    #[error("job candidate does not match the configured reward policy")]
+    RewardPolicyMismatch,
+    #[error("Bitcoin Core proposal validation was unavailable")]
+    ProposalUnavailable,
+    #[error("Bitcoin Core returned a non-success proposal result")]
+    ProposalRejected,
+    #[error("job admission exceeded its configured deadline")]
+    Timeout,
+    #[error("job admission was superseded by a newer template")]
+    StaleGeneration,
+    #[error("admitted job could not be released")]
+    ReleaseFailed,
+}
+
+impl AdmissionError {
+    pub(crate) fn category(&self) -> &'static str {
+        match self {
+            Self::MissingTemplateData => "missing_template_data",
+            Self::PreviousBlockMismatch => "previous_block_mismatch",
+            Self::TargetMismatch => "target_mismatch",
+            Self::TransactionMismatch => "transaction_mismatch",
+            Self::CommitmentMismatch => "commitment_mismatch",
+            Self::RewardPolicyMismatch => "reward_policy_mismatch",
+            Self::ProposalUnavailable => "proposal_unavailable",
+            Self::ProposalRejected => "proposal_rejected",
+            Self::Timeout => "timeout",
+            Self::StaleGeneration => "stale_generation",
+            Self::ReleaseFailed => "release_failed",
+        }
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct BitcoinCoreJobAdmission {
+    client: BitcoindRpcClient,
+    expected_payout_script: ScriptBuf,
+    deadline: Duration,
+    proposal_slots: Arc<Semaphore>,
+}
+
+impl BitcoinCoreJobAdmission {
+    pub(crate) fn new(
+        client: BitcoindRpcClient,
+        expected_payout_script: ScriptBuf,
+        deadline: Duration,
+        maximum_concurrency: usize,
+    ) -> Result<Self, AdmissionError> {
+        if deadline.is_zero()
+            || deadline > Duration::from_secs(60)
+            || maximum_concurrency == 0
+            || maximum_concurrency > 1_024
+        {
+            return Err(AdmissionError::MissingTemplateData);
+        }
+        Ok(Self {
+            client,
+            expected_payout_script,
+            deadline,
+            proposal_slots: Arc::new(Semaphore::new(maximum_concurrency)),
+        })
+    }
+
+    pub(crate) async fn admit(
+        &self,
+        candidate: &UnadmittedJobVariant,
+    ) -> Result<AdmissionReceipt, AdmissionError> {
+        validate_candidate(candidate, &self.expected_payout_script)?;
+        let candidate_digest = candidate_digest(candidate)?;
+        let started = Instant::now();
+        let proposal = async {
+            let _permit = self
+                .proposal_slots
+                .acquire()
+                .await
+                .map_err(|_| AdmissionError::ProposalUnavailable)?;
+            propose_candidate(&self.client, candidate).await
+        };
+        tokio::time::timeout(self.deadline, proposal)
+            .await
+            .map_err(|_| AdmissionError::Timeout)??;
+        Ok(AdmissionReceipt {
+            candidate_digest,
+            latency_milliseconds: started.elapsed().as_millis(),
+        })
+    }
+
+    #[cfg(test)]
+    pub(crate) fn available_proposal_slots(&self) -> usize {
+        self.proposal_slots.available_permits()
+    }
+}
+
+pub(crate) fn validate_candidate(
+    candidate: &UnadmittedJobVariant,
+    expected_payout_script: &ScriptBuf,
+) -> Result<(), AdmissionError> {
+    let block = candidate.canonical_block();
+    let template = candidate.block_template();
+    let expected_previous = template
+        .previousblockhash
+        .parse::<bitcoin::BlockHash>()
+        .map_err(|_| AdmissionError::MissingTemplateData)?;
+    if block.header.prev_blockhash != expected_previous {
+        return Err(AdmissionError::PreviousBlockMismatch);
+    }
+    let expected_target = hex::decode(&template.target)
+        .ok()
+        .and_then(|bytes| <[u8; 32]>::try_from(bytes).ok())
+        .ok_or(AdmissionError::MissingTemplateData)?;
+    if Target::from_compact(block.header.bits).to_be_bytes() != expected_target {
+        return Err(AdmissionError::TargetMismatch);
+    }
+    if block.txdata.len() != template.transactions.len() + 1 {
+        return Err(AdmissionError::TransactionMismatch);
+    }
+    for (transaction, expected) in block.txdata[1..].iter().zip(&template.transactions) {
+        if transaction.compute_txid().to_string() != expected.txid
+            || transaction.compute_wtxid().to_string() != expected.hash
+        {
+            return Err(AdmissionError::TransactionMismatch);
+        }
+    }
+    if !block.check_merkle_root() || !block.check_witness_commitment() {
+        return Err(AdmissionError::CommitmentMismatch);
+    }
+    let coinbase = block
+        .txdata
+        .first()
+        .ok_or(AdmissionError::MissingTemplateData)?;
+    let expected_witness_commitment = template
+        .default_witness_commitment
+        .as_deref()
+        .ok_or(AdmissionError::MissingTemplateData)?;
+    if coinbase
+        .output
+        .last()
+        .map(|output| output.script_pubkey.to_hex_string())
+        .as_deref()
+        != Some(expected_witness_commitment)
+    {
+        return Err(AdmissionError::CommitmentMismatch);
+    }
+    if coinbase.output.len() != 2
+        || coinbase.output[0].script_pubkey != *expected_payout_script
+        || coinbase.output[0].value.to_sat() != template.coinbasevalue
+        || coinbase.output[1].value.to_sat() != 0
+        || !coinbase.output[1].script_pubkey.is_op_return()
+    {
+        return Err(AdmissionError::RewardPolicyMismatch);
+    }
+    validate_work_id(template.workid.as_deref())
+}
+
+async fn propose_candidate(
+    client: &BitcoindRpcClient,
+    candidate: &UnadmittedJobVariant,
+) -> Result<(), AdmissionError> {
+    propose_block(
+        client,
+        candidate.canonical_block(),
+        candidate.block_template().workid.as_deref(),
+    )
+    .await
+}
+
+pub(crate) async fn propose_block(
+    client: &BitcoindRpcClient,
+    block: &bitcoin::Block,
+    maybe_work_id: Option<&str>,
+) -> Result<(), AdmissionError> {
+    let mut proposal = Map::new();
+    proposal.insert("mode".to_string(), json!("proposal"));
+    proposal.insert("data".to_string(), json!(hex::encode(serialize(block))));
+    if let Some(work_id) = maybe_work_id {
+        proposal.insert("workid".to_string(), json!(work_id));
+    }
+    let response = client
+        .request::<Value>("getblocktemplate", vec![Value::Object(proposal)])
+        .await
+        .map_err(|_| AdmissionError::ProposalUnavailable)?;
+    if response.is_null() {
+        return Ok(());
+    }
+    Err(AdmissionError::ProposalRejected)
+}
+
+fn validate_work_id(maybe_work_id: Option<&str>) -> Result<(), AdmissionError> {
+    if maybe_work_id.is_some_and(|work_id| {
+        work_id.is_empty()
+            || work_id.len() > 128
+            || !work_id.bytes().all(|byte| byte.is_ascii_graphic())
+    }) {
+        return Err(AdmissionError::MissingTemplateData);
+    }
+    Ok(())
+}
+
+fn candidate_digest(candidate: &UnadmittedJobVariant) -> Result<String, AdmissionError> {
+    let mut digest = Sha256::new();
+    digest.update(b"P2Poolv2 job admission candidate v1\0");
+    digest.update(serialize(candidate.canonical_block()));
+    digest.update([0]);
+    digest.update(WORKER_MUTATION_PROFILE.as_bytes());
+    digest.update([0]);
+    if let Some(work_id) = candidate.block_template().workid.as_ref() {
+        digest.update(work_id.as_bytes());
+    }
+    Ok(hex::encode(digest.finalize()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn deepest_constructor_rejects_out_of_profile_bounds() {
+        // Arrange
+        let client = BitcoindRpcClient::new("http://127.0.0.1:1", "user", "secret")
+            .expect("test client should build");
+
+        // Act
+        let excessive_timeout = BitcoinCoreJobAdmission::new(
+            client.clone(),
+            ScriptBuf::new(),
+            Duration::from_secs(61),
+            1,
+        );
+        let excessive_concurrency =
+            BitcoinCoreJobAdmission::new(client, ScriptBuf::new(), Duration::from_secs(1), 1_025);
+
+        // Assert
+        assert!(matches!(
+            excessive_timeout,
+            Err(AdmissionError::MissingTemplateData)
+        ));
+        assert!(matches!(
+            excessive_concurrency,
+            Err(AdmissionError::MissingTemplateData)
+        ));
+    }
+}
