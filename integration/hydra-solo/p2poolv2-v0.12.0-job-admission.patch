+async fn build_admitted_notify<W>(
+    prepared: Arc<PreparedNotifyParams>,
+    commitment_address: Option<&bitcoin::Address>,
+    assigned_extranonce1: &str,
+    context: &StratumContext,
+    template_rx: &watch::Receiver<Option<Arc<PreparedNotifyParams>>>,
+    writer: &mut W,
+) -> Result<(), AdmissionError>
+where
+    W: AsyncWrite + Unpin,
+{
+    let Some(admission) = context.job_admission() else {
+        let notify_json =
+            build_notify_from_prepared(&prepared, commitment_address, &context.tracker_handle)
+                .map_err(|_| AdmissionError::MissingTemplateData)?;
+        writer
+            .write_all(format!("{notify_json}\n").as_bytes())
+            .await
+            .map_err(|_| AdmissionError::ReleaseFailed)?;
+        return Ok(());
+    };
+    let started = Instant::now();
+    let variant = build_unadmitted_job_variant(
+        &prepared,
+        commitment_address,
+        &context.tracker_handle,
+        assigned_extranonce1,
+    )
+    .map_err(|_| AdmissionError::MissingTemplateData);
+    let variant = match variant {
+        Ok(variant) => variant,
+        Err(error) => {
+            warn!(
+                category = error.category(),
+                latency_milliseconds = started.elapsed().as_millis(),
+                "Job admission failed"
+            );
+            return Err(error);
+        }
+    };
+    let job_id = variant.job_id();
+    let receipt = match admission.admit(&variant).await {
+        Ok(receipt) => receipt,
+        Err(error) => {
+            warn!(
+                category = error.category(),
+                job_id = job_id.0,
+                latency_milliseconds = started.elapsed().as_millis(),
+                "Job admission failed"
+            );
+            return Err(error);
+        }
+    };
+    let generation_gate = context.generation_gate();
+    if let Err(error) = publish_if_current(
+        &prepared,
+        template_rx,
+        variant,
+        &context.tracker_handle,
+        &generation_gate,
+        writer,
+    )
+    .await
+    {
+        warn!(
+            category = error.category(),
+            job_id = job_id.0,
+            latency_milliseconds = started.elapsed().as_millis(),
+            "Job admission failed"
+        );
+        return Err(error);
+    }
+    info!(
+        category = "accepted",
+        job_id = job_id.0,
+        candidate_digest = receipt.candidate_digest(),
+        latency_milliseconds = started.elapsed().as_millis(),
+        proposal_latency_milliseconds = receipt.latency_milliseconds(),
+        "Job admission completed"
+    );
+    Ok(())
+}
+
+pub(crate) async fn publish_if_current<W>(
+    admitted: &Arc<PreparedNotifyParams>,
+    template_rx: &watch::Receiver<Option<Arc<PreparedNotifyParams>>>,
+    variant: crate::stratum::work::prepared_notify::UnadmittedJobVariant,
+    tracker: &JobTracker,
+    generation_gate: &JobGenerationGate,
+    writer: &mut W,
+) -> Result<(), AdmissionError>
+where
+    W: AsyncWrite + Unpin,
+{
+    let _generation_guard = generation_gate.lock().await;
+    let is_current = {
+        let current = template_rx.borrow();
+        current
+            .as_ref()
+            .is_some_and(|current| Arc::ptr_eq(current, admitted))
+    };
+    if is_current {
+        let job_id = variant.job_id();
+        let notify_json = publish_admitted_job_variant(variant, tracker);
+        let release = tokio::time::timeout(
+            JOB_RELEASE_TIMEOUT,
+            writer.write_all(format!("{notify_json}\n").as_bytes()),
+        )
+        .await;
+        if matches!(release, Ok(Ok(()))) {
+            return Ok(());
+        }
+        tracker.remove_job(job_id);
+        return Err(AdmissionError::ReleaseFailed);
+    }
+    Err(AdmissionError::StaleGeneration)
 }
 
