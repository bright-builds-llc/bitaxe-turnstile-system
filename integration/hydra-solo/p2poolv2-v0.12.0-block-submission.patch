+/// Independently bounded deadline for the latency-critical Bitcoin Core submit path.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct BlockSubmissionTimeout(Duration);
+
+impl TryFrom<Duration> for BlockSubmissionTimeout {
+    type Error = &'static str;
+
+    fn try_from(value: Duration) -> Result<Self, Self::Error> {
+        if value < Duration::from_millis(1) || value > Duration::from_secs(60) {
+            return Err("block submission timeout must be between 1 ms and 60 seconds");
+        }
+        Ok(Self(value))
+    }
+}
+
+impl Default for BlockSubmissionTimeout {
+    fn default() -> Self {
+        Self(Duration::from_secs(2))
+    }
+}
+
+impl BlockSubmissionTimeout {
+    fn duration(self) -> Duration {
+        self.0
+    }
+}
