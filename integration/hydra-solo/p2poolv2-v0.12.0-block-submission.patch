+pub(crate) enum BlockSubmissionOutcome {
+    Accepted,
+    Duplicate,
+    Rejected,
+    Inconclusive,
+    Unavailable,
+}
+
+/// Submit a network-qualified block to Bitcoin Core without consulting pool or gate accounting.
+pub(crate) async fn submit_block(
+    block: &Block,
+    bitcoindrpc_client: &BitcoindRpcClient,
+    deadline: Duration,
+) -> BlockSubmissionOutcome {
+    let started = Instant::now();
+    let block_hash = block.header.block_hash();
+    let submission = tokio::time::timeout(deadline, bitcoindrpc_client.submit_block(block)).await;
+    let outcome = match submission {
+        Err(_) => BlockSubmissionOutcome::Unavailable,
+        Ok(Ok(RpcSubmitBlockOutcome::Accepted)) => BlockSubmissionOutcome::Accepted,
+        Ok(Ok(RpcSubmitBlockOutcome::Duplicate)) => BlockSubmissionOutcome::Duplicate,
+        Ok(Ok(RpcSubmitBlockOutcome::Inconclusive)) => BlockSubmissionOutcome::Inconclusive,
+        Ok(Ok(RpcSubmitBlockOutcome::DuplicateInvalid | RpcSubmitBlockOutcome::Rejected)) => {
+            BlockSubmissionOutcome::Rejected
+        }
+        Ok(Err(_)) => BlockSubmissionOutcome::Unavailable,
+    };
+    info!(
+        block_hash = %block_hash,
+        outcome = ?outcome,
+        latency_milliseconds = started.elapsed().as_millis(),
+        "Bitcoin block submission completed"
     );
-    match bitcoindrpc_client.submit_block(block).await {
-        Ok(_) => info!("Block submitted successfully"),
-        Err(e) => error!("Failed to submit block: {}", e),
-    }
+    outcome
 }
 
