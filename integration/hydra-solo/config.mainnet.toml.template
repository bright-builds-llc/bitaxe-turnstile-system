# Mainnet Hydra for Ticket 07, rendered by scripts/hydra-mainnet-stack.sh. Difficulty
# is bounded at 4096, one share for the Gate's 2^44 requirement. Unbounded, Hydra's
# vardiff can climb out of a Worker's reach or saturate and overflow.
[network]
listen_address = "/ip4/127.0.0.1/tcp/__P2P_PORT__"
dial_peers = []
max_pending_incoming = 10
max_pending_outgoing = 10
max_established_incoming = 10
max_established_outgoing = 10
max_established_per_peer = 1
max_workbase_per_second = 10
max_userworkbase_per_second = 10
max_miningshare_per_second = 100
max_inventory_per_second = 100
max_transaction_per_second = 100
max_requests_per_second = 100
dial_timeout_secs = 5

[store]
path = "__STORE_PATH__"
background_task_frequency_hours = 24
pplns_ttl_days = 7

[stratum]
hostname = "127.0.0.1"
port = __STRATUM_PORT__
start_difficulty = 4096
minimum_difficulty = 100
maximum_difficulty = 4096
solo_address = "__PAYOUT_ADDRESS__"
bootstrap_address = "__PAYOUT_ADDRESS__"
zmqpubhashblock = "tcp://127.0.0.1:__ZMQ_PORT__"
network = "main"
version_mask = "1fffe000"
difficulty_multiplier = 1.0
pool_signature = "BWG-Hydra"
max_connections = 16
# No peers, so the share chain's tip stays the genesis share; waiting for a recent
# tip would keep Stratum closed forever.
wait_for_chain_sync = false
require_job_admission = true
job_admission_timeout_ms = 2000
job_admission_max_concurrency = 8
block_submission_timeout_ms = 2000
mode = "hydrapool"

[bitcoinrpc]
url = "http://127.0.0.1:__RPC_PORT__"
# Hydra reads username and password from P2POOL_BITCOINRPC_USERNAME and
# P2POOL_BITCOINRPC_PASSWORD, set by start_hydra.

[logging]
console = true
level = "info"
stats_dir = "__STATS_PATH__"

[api]
hostname = "127.0.0.1"
port = __API_PORT__
